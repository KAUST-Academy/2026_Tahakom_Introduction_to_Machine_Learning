# Generated site and bundles — never commit these, they are rebuilt by
# `python3 build.py`. Committing them is what makes course repos bloat.
/_site/
/dist/
/wheelhouse/

# LaTeX intermediates: LaTeX/build.sh deletes them unless run with --keep-logs.
/LaTeX/*.aux
/LaTeX/*.bbl
/LaTeX/*.bcf
/LaTeX/*.blg
/LaTeX/*.fdb_latexmk
/LaTeX/*.fls
/LaTeX/*.log
/LaTeX/*.nav
/LaTeX/*.out
/LaTeX/*.pdf
/LaTeX/*.run.xml
/LaTeX/*.snm
/LaTeX/*.synctex.gz
/LaTeX/*.toc
/LaTeX/*.vrb
/LaTeX/build/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints/

# Editors / OS
.DS_Store
Thumbs.db
.vscode/
.idea/

# Claude Code local settings (machine-specific, never share)
.claude/

# What the labs download or write when run from a clone
Labs/**/data/FashionMNIST/
Labs/Day_5/yolo_models/
datasets/
runs/
yolo11*.pt
*.onnx
Labs/**/video/
Labs/**/*.gif
mlflow.db
mlartifacts/
mlruns/
